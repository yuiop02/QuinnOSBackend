OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# API service
PORT=8787
HOST=0.0.0.0
VOICE_BASE_URL=http://127.0.0.1:8788
VOICE_PROXY_ONLY=false

# Persistent Quinn memory
# Set QUINNOS_STORAGE_DIR to a Railway volume mount path such as /data
# or set QUINNOS_MEMORY_FILE directly to a specific JSON file path.
QUINNOS_STORAGE_DIR=
QUINNOS_MEMORY_FILE=

# Voice service
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_VOICE_PORT=8788
QUINN_VOICE_PORT=8788
VOICE_CACHE_TTL_MS=600000
